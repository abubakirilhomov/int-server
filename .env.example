PORT=8000
MONGO_URI=mongodb://localhost:27017/intern-system
JWT_SECRET=replace_with_jwt_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
VAPID_PUBLIC_KEY=replace_with_vapid_public
VAPID_PRIVATE_KEY=replace_with_vapid_private

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# Audit log (все опциональны — значения ниже совпадают с дефолтами в коде)
# AUDIT_ENABLED=true            # false — полностью выключает запись журнала
# AUDIT_RETENTION_DAYS=180      # TTL записей; смена на живой коллекции требует collMod
# AUDIT_FLUSH_MS=2000           # период слива буфера пачкой в Mongo
# AUDIT_MAX_BODY_BYTES=4096     # потолок размера сохраняемого тела мутации

# Error tracking (все опциональны — значения ниже совпадают с дефолтами в коде)
# ERROR_TRACKING_ENABLED=true    # false — полностью выключает отлов ошибок
# ERROR_RETENTION_DAYS=30        # TTL сырых событий; issue живут вечно
# ERROR_FLUSH_MS=2000            # период слива буфера событий в Mongo
# ERROR_MAX_BODY_BYTES=16384     # потолок сохраняемых context/breadcrumbs
# ERROR_INGEST_MAX_BODY=64kb     # потолок тела POST /api/error-reports
# ERROR_INGEST_RATE_MAX=30       # отчётов в минуту с одного IP
# ERROR_INGEST_MAX_BATCH=20      # событий в одном запросе

# Уведомления об ошибках в Telegram (переиспользуют TELEGRAM_BOT_TOKEN)
# ERROR_ALERTS_ENABLED=true
# ERROR_ALERT_CHAT_IDS=          # через запятую; пусто = уведомления молчат
# ERROR_ALERT_COOLDOWN_MIN=30    # кулдаун на один issue; 0 = без кулдауна
# ERROR_ALERT_MAX_PER_HOUR=20    # общий потолок, чтобы веерное падение не залило чат
